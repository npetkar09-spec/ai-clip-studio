{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "lib": [
      "es2020"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "outDir": "build",
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "app-overlay/src/**/*.ts"
  ]
}